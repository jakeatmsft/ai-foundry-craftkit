# Public model lookup needs no credentials. Use the exact slug in the catalog URL.
CATALOG_MODEL_NAME=Phi-4
# Blank selects the version currently displayed by the catalog.
CATALOG_MODEL_VERSION=

# Optional authenticated examples; disabled by default in the notebook.
AZURE_SUBSCRIPTION_ID=
AZURE_LOCATION=eastus
AZURE_MODELS_API_VERSION=2025-06-01
# For DefaultAzureCredential locally, run az login; in Azure use managed identity.
# Service principal alternative: AZURE_TENANT_ID, AZURE_CLIENT_ID, AZURE_CLIENT_SECRET.
