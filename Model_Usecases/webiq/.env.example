# Microsoft Entra app registration used to obtain the bearer token.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=replace-with-your-client-secret

# Client AppID passed to WebIQ as the oboappid request parameter.
WEBIQ_CLIENT_APP_ID=58A45A6B47D7504B275D70F9B920EA4252FBECDF

# Optional: when set, auto auth uses this instead of Microsoft Entra.
WEBIQ_API_KEY=
