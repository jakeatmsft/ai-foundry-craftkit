# MAI Image project configuration (Microsoft Entra ID auth, no API keys)
# Resource root only: omit project paths and /mai/v1/images/generations.
AZURE_ENDPOINT="https://contoso.services.ai.azure.com"

# Use the exact deployment name from your Foundry resource.
DEPLOYMENT_NAME="<your-deployment-name>"

# Optional request defaults used by the notebook
IMAGE_PROMPT="A photorealistic image of an anthropomorphic axolotl in space with Mars in the background taking a selfie"
# Each dimension must be >= 768; width * height must be <= 1,048,576.
IMAGE_WIDTH="1024"
IMAGE_HEIGHT="1024"
# A fresh timestamp is appended when saving; output is always PNG.
OUTPUT_PATH="output.png"

# Optional: use these only when authenticating with a service principal.
# If omitted, DefaultAzureCredential can use Azure CLI or Managed Identity.
# AZURE_TENANT_ID="<tenant-id>"
# AZURE_CLIENT_ID="<client-id>"
# AZURE_CLIENT_SECRET="<client-secret>"

# GPT Image showcase (separate from the MAI settings above).
# See the new notebook / README for the two supplied resource endpoints.
AZURE_OPENAI_ENDPOINT="https://contoso.openai.azure.com"
AZURE_OPENAI_API_VERSION="2025-04-01-preview"
GPT_IMAGE_15_DEPLOYMENT="gpt-image-1.5"
GPT_IMAGE_FLARE_DEPLOYMENT="gpt-image-2.5-flare"
GPT_IMAGE_SUNBURST_DEPLOYMENT="gpt-image-2.5-sunburst"

# GPT Image 2 is deployed on a different resource; it never uses the first endpoint.
AZURE_OPENAI_GPT_IMAGE_2_ENDPOINT="https://contoso-secondary.cognitiveservices.azure.com"
AZURE_OPENAI_GPT_IMAGE_2_API_VERSION="2025-04-01-preview"
GPT_IMAGE_2_DEPLOYMENT="gpt-image-2"

GPT_IMAGE_QUALITY="medium"
GPT_IMAGE_SIZE="1024x1024"
GPT_IMAGE_OUTPUT_DIR="outputs/gpt-image-showcase"

# Offline token / cost comparison notebook. Paths are relative to this project.
GPT_IMAGE_COST_INPUT="output/jupyter-notebook/comparisons"
GPT_IMAGE_COST_OUTPUT_DIR="output/jupyter-notebook/cost-analysis"
GPT_IMAGE_COST_VOLUME="1000"
# Optional: copy assets/azure_image_rates.example.json, fill in your Azure rates,
# and set the path here. Defaults: public OpenAI reference rates for GPT plus
# user-supplied MAI-Image-2 starting rates ($5 text input / $33 image output per 1M tokens).
# GPT_IMAGE_PRICING_FILE="assets/azure_image_rates.json"

# MAI models in the six-model showcase (separate REST API, no api-version).
AZURE_MAI_ENDPOINT="https://contoso-mai.services.ai.azure.com"
MAI_IMAGE_26_DEPLOYMENT="MAI-Image-2.6"
MAI_IMAGE_26_FLASH_DEPLOYMENT="MAI-Image-2.6-Flash"
MAI_IMAGE_WIDTH="1024"
MAI_IMAGE_HEIGHT="1024"
MAI_IMAGE_MIN_INTERVAL_SECONDS="30"
