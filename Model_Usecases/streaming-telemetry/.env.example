# Azure OpenAI v1 base URL. The trailing /openai/v1/ segment is added if omitted.
AZURE_OPENAI_ENDPOINT="https://contoso-openai.openai.azure.com/openai/v1/"
AZURE_OPENAI_DEPLOYMENT="your-deployment-name"
AZURE_TENANT_ID="00000000-0000-0000-0000-000000000000"
# Current Microsoft Foundry v1 documentation uses this Entra scope.
AZURE_OPENAI_TOKEN_SCOPE="https://ai.azure.com/.default"

# Optional probe defaults. Keep the output limit explicit; do not use -1.
AZURE_OPENAI_MAX_COMPLETION_TOKENS="256"
# Use "chat-completions" to reproduce the support case or "responses" for the current docs example.
AZURE_OPENAI_STREAMING_API="chat-completions"
# AZURE_OPENAI_REASONING_EFFORT="low"
STREAMING_RUNS="5"
STREAMING_WARMUP_RUNS="1"
STREAMING_DELAY_SECONDS="1"
STREAMING_TIMEOUT_SECONDS="120"
STREAMING_RAW_EVENT_LIMIT="0"
STREAMING_PATH="DIRECT"
STREAMING_TIER="dev"
STREAMING_SERVING="False"
STREAMING_WORKSPACE="not set"
# AZURE_OPENAI_API_VERSION="2025-01-01-preview"
# STREAMING_MAX_TTFT_MS="2000"
# STREAMING_MAX_TOTAL_MS="10000"
